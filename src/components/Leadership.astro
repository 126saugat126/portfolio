---
import { leadership as l } from '../data/resume';

// Seven-segment geometry for one digit in a 60 x 104 cell.
const T = 10;
const hseg = (y: number, x0 = 4, x1 = 56) =>
  [[x0 + T / 2 + 1, y], [x0 + T + 1, y - T / 2], [x1 - T - 1, y - T / 2], [x1 - T / 2 - 1, y], [x1 - T - 1, y + T / 2], [x0 + T + 1, y + T / 2]];
const vseg = (x: number, y0: number, y1: number) =>
  [[x, y0 + T / 2 + 1], [x + T / 2, y0 + T + 1], [x + T / 2, y1 - T - 1], [x, y1 - T / 2 - 1], [x - T / 2, y1 - T - 1], [x - T / 2, y0 + T + 1]];
const SEG: Record<string, number[][]> = {
  a: hseg(8), g: hseg(52), d: hseg(96),
  f: vseg(8, 8, 52), b: vseg(52, 8, 52), e: vseg(8, 52, 96), c: vseg(52, 52, 96),
};
const MAP: Record<string, string> = {
  '0': 'abcdef', '1': 'bc', '2': 'abged', '3': 'abgcd', '4': 'fgbc',
  '5': 'afgcd', '6': 'afgedc', '7': 'abc', '8': 'abcdefg', '9': 'abcdfg',
};
const digits = String(l.count).padStart(2, '0').split('');
const pts = (p: number[][]) => p.map((q) => q.join(',')).join(' ');
---
<section id="leadership" class="node" data-node data-pad-offset="28">
  <header class="sec-head" data-pull><span class="ref">U6</span><h2>Leadership</h2></header>

  <div class="band">
    <figure class="disp" data-pull style="--i:1">
      <svg viewBox={`0 0 ${digits.length * 76 + 8} 112`} role="img" aria-label={`${l.count} students`}>
        <g transform="skewX(-7) translate(14 4)">
          {digits.map((d, i) => (
            <g transform={`translate(${i * 76} 0)`}>
              {Object.entries(SEG).map(([k, p]) => (
                <polygon points={pts(p)} class={MAP[d].includes(k) ? 'on' : 'off'} />
              ))}
            </g>
          ))}
        </g>
      </svg>
      <figcaption>high school students mentored</figcaption>
    </figure>

    <div class="txt">
      <p class="prog" data-pull style="--i:2">{l.program}</p>
      <h3 data-pull style="--i:3">{l.role}</h3>
      <p class="when" data-pull style="--i:4">{l.when}</p>
      <p class="det" data-pull style="--i:5">{l.detail}</p>
    </div>
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .disp {
    margin: 0;
    background: #0b0f0d;
    border: 10px solid #1c211e;
    border-radius: 6px;
    padding: clamp(22px, 3vw, 36px) clamp(22px, 3vw, 40px) 18px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
  }
  svg { width: 100%; max-width: 300px; height: auto; display: block; margin: 0 auto; }
  .on { fill: #ff7a45; filter: drop-shadow(0 0 6px rgba(255, 122, 69, 0.7)); }
  .off { fill: #231a16; }
  figcaption { margin-top: 16px; text-align: center; font: 500 13px/1.3 var(--mono); color: var(--silk-2); }

  .txt { display: grid; gap: 10px; }
  .prog { font: 600 15px/1.3 var(--mono); color: var(--copper-hot); }
  h3 { font: 800 clamp(40px, 5vw, 64px)/0.95 var(--display); text-transform: uppercase; }
  .when { color: var(--silk-2); font-size: 16px; }
  .det { font-size: clamp(18px, 1.7vw, 22px); line-height: 1.5; max-width: 30em; margin-top: 8px; }

  @media (max-width: 760px) {
    .band { grid-template-columns: 1fr; }
  }
</style>
