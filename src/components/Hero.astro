---
import { person } from '../data/resume';
const base = import.meta.env.BASE_URL;
const photo = person.photo ? `${base}${person.photo}`.replace(/\/\//g, '/') : '';
// QFN footprint: 9 pads per side
const pads = Array.from({ length: 9 }, (_, i) => 14 + i * 9);
---
<section id="top" class="node hero" data-node data-pad-offset="20">
  <div class="text">
    <span class="ref" data-pull style="--i:0">U1</span>
    <h1 data-pull style="--i:1">Saugat<br />Karki</h1>
    <p class="role" data-pull style="--i:2">{person.location} &nbsp;/&nbsp; Co-op at Hunter Engineering &nbsp;/&nbsp; Class of 2027</p>
    <p class="intro" data-pull style="--i:3">{person.intro}</p>
    <div class="actions" data-pull style="--i:4">
      <a class="pad" href={`mailto:${person.email}`}>Email</a>
      <a class="pad" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="pad" href={person.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>

  <figure class="chip" data-pull style="--i:3">
    <svg class="pads" viewBox="0 0 100 100" aria-hidden="true">
      {pads.map((p) => <>
        <rect x={p - 2.2} y="0" width="4.4" height="7" />
        <rect x={p - 2.2} y="93" width="4.4" height="7" />
        <rect x="0" y={p - 2.2} width="7" height="4.4" />
        <rect x="93" y={p - 2.2} width="7" height="4.4" />
      </>)}
      <circle cx="13" cy="13" r="1.6" class="pin1" />
    </svg>
    <div class="die slot">
      {photo ? <img src={photo} alt={`Portrait of ${person.name}`} /> : <span>Headshot goes here</span>}
    </div>
    <figcaption>U1 &nbsp; QFN-36 &nbsp; SKARKI-27</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    min-height: calc(100vh - 200px);
  }
  .text { display: grid; gap: 22px; justify-items: start; }
  h1 {
    font: 900 clamp(72px, 12vw, 172px)/0.86 var(--display);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--silk);
  }
  .role { font: 500 14px/1.5 var(--mono); color: var(--copper-hot); }
  .intro { max-width: 34em; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--silk-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .pad {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 22px;
    background: var(--copper);
    color: var(--ink);
    font: 600 16px/1 var(--body);
    text-decoration: none;
    border-radius: 2px;
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.22);
    transition: background 0.2s, transform 0.2s var(--ease);
  }
  .pad:hover { background: var(--copper-hot); transform: translateY(-2px); }

  .chip { position: relative; margin: 0; aspect-ratio: 1; width: 100%; max-width: 380px; justify-self: end; }
  .pads { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pads rect { fill: var(--gold); }
  .pads .pin1 { fill: var(--silk); }
  .die {
    position: absolute;
    inset: 10%;
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
  }
  figcaption {
    position: absolute;
    left: 0; right: 0; bottom: -34px;
    text-align: center;
    font: 500 13px/1 var(--mono);
    color: var(--silk-2);
  }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .chip { justify-self: start; max-width: 300px; margin-bottom: 30px; }
  }
</style>
